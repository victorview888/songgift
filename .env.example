# Provider routing
LYRICS_PROVIDER=deepseek
MUSIC_PROVIDER=musicapi

# Optional mock fallback for the retained Mureka / Google music adapters.
ALLOW_MOCK_FALLBACK=false

# DeepSeek lyrics API (usage billed against your DeepSeek account)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional Gemini Developer API adapter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Vertex AI / Lyria
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_LYRIA_MODEL=lyria-3-pro-preview

# A server-side OAuth access token. Do not expose this in NEXT_PUBLIC_* variables.
GOOGLE_ACCESS_TOKEN=
# Optional alias if you use a separate token name.
GOOGLE_LYRIA_ACCESS_TOKEN=

# Optional custom Lyria endpoint for a gateway or future provider adapter.
GOOGLE_LYRIA_ENDPOINT=

# Mureka China API
MUREKA_API_KEY=
MUREKA_API_BASE_URL=https://api.mureka.cn
MUREKA_MODEL=auto

# MusicAPI.ai Sonic. An API key is required to use free signup credits.
MUSICAPI_KEY=
MUSICAPI_BASE_URL=https://api.musicapi.ai/api/v1
MUSICAPI_MODEL=sonic-v5

# Supabase server-side persistence
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=songs
SUPABASE_SIGNED_URL_SECONDS=3600

# PayPal checkout (use sandbox while testing)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
SONG_PRICE_USD=9.99
PAYPAL_BRAND_NAME=SongGift
PAYPAL_RETURN_URL=http://localhost:3000/lyrics/demo
PAYPAL_CANCEL_URL=http://localhost:3000/lyrics/demo

# Resend email delivery
RESEND_API_KEY=
SONGGIFT_FROM_EMAIL=SongGift <songs@example.com>
